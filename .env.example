# ==============================================================================
# CyberShield AI — Environment Configuration
# ==============================================================================

# Option 1: Standalone Vercel Serverless Mode (Zero-Config Default)
# Leave BACKEND_URL empty and CyberShield will run 100% self-contained on Vercel!

# Option 2: External Python FastAPI Backend (Optional)
# If you host the backend on Render, Railway, Fly.io, or VPS, set its public URL here:
# BACKEND_URL=https://cybershield-backend.onrender.com
# NEXT_PUBLIC_API_URL=https://cybershield-backend.onrender.com/api/v1

# Optional AI & Threat Feed Keys
# GEMINI_API_KEY=
# GOOGLE_SAFE_BROWSING_KEY=
